# FlowLedger local development environment
#
# Copy this file to .env in the repository root and fill in your own values:
#   Copy-Item .env.example .env
# .env is ignored by Git. Never commit real passwords.
#
# This file is read by BOTH Docker Compose (automatically) and the Spring Boot services
# (via spring.config.import in application.properties), so keep it to plain KEY=VALUE
# lines: no quotes around values, no "export", and avoid backslashes.

# --- Docker Compose: PostgreSQL container (compose.yaml) ---
# Password the identity-db container sets for the flowledger_app user.
# Only applied when the database volume is first created.
IDENTITY_DB_PASSWORD=change-me

# --- Spring Boot: identity-service ---
# Password the application uses to connect to the database.
# For local development with compose.yaml, this must equal IDENTITY_DB_PASSWORD.
DB_PASSWORD=change-me

# Signing key for JWT access tokens: Base64, at least 32 random bytes. identity-service signs
# tokens with it; bank-integration-service and cash-management-service validate them, so all
# three read this one value. None of them will start without it. Generate one in Git Bash with:
#   openssl rand -base64 32
# or in PowerShell with:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Shared secret for identity-service's internal API (/internal/**). identity-service requires it;
# bank-integration-service and cash-management-service send it when checking company membership.
# Must be different from JWT_SECRET and at least 32 characters. None of them will start without it.
# Generate one in Git Bash with:
#   openssl rand -hex 32
IDENTITY_INTERNAL_API_SECRET=

# Optional overrides (defaults shown, matching compose.yaml):
# DB_URL=jdbc:postgresql://localhost:5433/flowledger_identity
# DB_USERNAME=flowledger_app

# --- bank-integration-service ---
# Used by both the bank-integration-db container and the application.
# The container only applies it when its database volume is first created.
BANK_INTEGRATION_DB_PASSWORD=change-me

# Optional overrides (defaults shown, matching compose.yaml):
# BANK_INTEGRATION_DB_URL=jdbc:postgresql://localhost:5434/flowledger_bank_integration
# BANK_INTEGRATION_DB_USERNAME=flowledger_app

# --- cash-management-service ---
# Used by both the cash-management-db container and the application.
# The container only applies it when its database volume is first created.
CASH_MANAGEMENT_DB_PASSWORD=change-me

# Optional overrides (defaults shown, matching compose.yaml):
# CASH_MANAGEMENT_DB_URL=jdbc:postgresql://localhost:5435/flowledger_cash_management
# CASH_MANAGEMENT_DB_USERNAME=flowledger_app

# Where bank-integration-service and cash-management-service reach identity-service. The default
# is for the services running on this machine. Inside Docker Compose, use the identity-service
# container name (for example http://identity-service:8080), because localhost is the container itself.
# IDENTITY_SERVICE_URL=http://localhost:8080
