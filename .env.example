# FlowLedger local development settings.
# Copy to .env (git-ignored) and replace the placeholders. Plain KEY=VALUE lines only:
# read by Docker Compose, every backend service and the Vite dev server.

# Databases (one PostgreSQL container per service)
IDENTITY_DB_PASSWORD=change-me
CASH_MANAGEMENT_DB_PASSWORD=change-me
BANK_INTEGRATION_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
FORECAST_DB_PASSWORD=change-me
# Optional overrides: <SERVICE>_DB_URL and <SERVICE>_DB_USERNAME (defaults match compose.yaml)

# Security (required; generate with: openssl rand -base64 32 / openssl rand -hex 32)
JWT_SECRET=
IDENTITY_INTERNAL_API_SECRET=
# Must differ from IDENTITY_INTERNAL_API_SECRET; payment-service internal API key, same value for forecast-service (cheque backfill)
PAYMENT_INTERNAL_API_SECRET=

# RabbitMQ (local broker in compose.yaml; payment-service publishes cheque events, forecast-service consumes them)
RABBITMQ_USERNAME=flowledger
RABBITMQ_PASSWORD=change-me
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# OUTBOX_PUBLISHER_ENABLED=true
# CHEQUE_EVENTS_CONSUMER_ENABLED=true
# forecast-service fills and verifies its cheque projection after startup. Keep true locally:
# a forecast is refused until one backfill has completed (service default false).
CHEQUE_BACKFILL_ON_STARTUP=true
# CHEQUE_VERIFICATION_MAX_AGE=0s

# Service URLs (defaults shown; inside Docker use container or host names, not localhost)
# IDENTITY_SERVICE_URL=http://localhost:8080
# CASH_MANAGEMENT_SERVICE_URL=http://localhost:8081
# BANK_INTEGRATION_SERVICE_URL=http://localhost:8082
# PAYMENT_SERVICE_URL=http://localhost:8083
# FORECAST_SERVICE_URL=http://localhost:8084

# API gateway and frontend (defaults shown)
# API_GATEWAY_URL=http://localhost:8088
# GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
